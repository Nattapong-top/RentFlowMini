<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ชื่อไฟล์โปรแกรมที่ผู้ใช้เห็น ส่วน namespace ในโค้ดยังเป็น RentFlowApp -->
    <AssemblyName>RentFlowMiniApp</AssemblyName>
    <RootNamespace>RentFlowApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RentFlow.Core\RentFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="RentFlowApp.app.ico" />
  </ItemGroup>

</Project>
